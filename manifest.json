{
  "manifest_version": 3,
  "name": "OSINT Graph Mapper",
  "version": "1.0.0",
  "description": "Cartographie visuelle de réseaux relationnels OSINT (Pappers, SerpApi) sous forme de graphe neuronal.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://api.pappers.fr/*",
    "https://serpapi.com/*"
  ],
  "background": {
    "scripts": ["background/background.js"],
    "service_worker": "background/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "osint-graph-mapper@example.com"
    }
  }
}
